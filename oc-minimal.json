{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg":          "#000000",
    "bgPanel":     "#000000",
    "bgElement":   "#111111",
    "bgMenu":      "#111111",
    "bgFold":      "#1a1a1a",
    "border":      "transparent",
    "borderActive":"transparent",
    "borderSubtle":"transparent",
    "text":        "#d0d0d0",
    "textMuted":   "#777777",
    "skyBlue":     "#87ceeb",
    "lightSky":    "#8db4cc",
    "seaGreen":    "#52c07a",
    "lightGreen":  "#00ff00",
    "cyan3":       "#00cdcd",
    "softBlue":    "#80a0ff",
    "orchid":      "#da70d6",
    "chartreuse":  "#7fff00",
    "fireBrick":   "#b22222",
    "darkCyan":    "#008b8b",
    "diffGreen":   "#006400",
    "foldText":    "#a0a0a0",
    "lineNr":      "#777777",
    "todo":        "#507080"
  },
  "theme": {
    "primary":                  { "dark": "textMuted",    "light": "textMuted" },
    "secondary":                { "dark": "textMuted",    "light": "textMuted" },
    "accent":                   { "dark": "bg",           "light": "bg" },
    "error":                    { "dark": "#a06060",      "light": "#a06060" },
    "warning":                  { "dark": "#a09070",      "light": "#a09070" },
    "success":                  { "dark": "#809080",      "light": "#809080" },
    "info":                     { "dark": "textMuted",    "light": "textMuted" },
    "text":                     { "dark": "text",         "light": "text" },
    "textMuted":                { "dark": "textMuted",    "light": "textMuted" },
    "background":               { "dark": "transparent",  "light": "transparent" },
    "selectedListItemText":     { "dark": "bg",           "light": "bg" },
    "backgroundPanel":          { "dark": "bgPanel",      "light": "bgPanel" },
    "backgroundElement":        { "dark": "bgElement",    "light": "bgElement" },
    "backgroundMenu":           { "dark": "bgMenu",       "light": "bgMenu" },
    "border":                   { "dark": "border",       "light": "border" },
    "borderActive":             { "dark": "borderActive", "light": "borderActive" },
    "borderSubtle":             { "dark": "borderSubtle", "light": "borderSubtle" },
    "diffAdded":                { "dark": "#809080",      "light": "#809080" },
    "diffRemoved":              { "dark": "#a06060",      "light": "#a06060" },
    "diffContext":              { "dark": "textMuted",    "light": "textMuted" },
    "diffHunkHeader":           { "dark": "bgFold",       "light": "bgFold" },
    "diffHighlightAdded":       { "dark": "#809080",      "light": "#809080" },
    "diffHighlightRemoved":     { "dark": "#a06060",      "light": "#a06060" },
    "diffAddedBg":              { "dark": "#0a1f0a",      "light": "#0a1f0a" },
    "diffRemovedBg":            { "dark": "#1f0a0a",      "light": "#1f0a0a" },
    "diffContextBg":            { "dark": "bgPanel",      "light": "bgPanel" },
    "diffLineNumber":           { "dark": "lineNr",       "light": "lineNr" },
    "diffAddedLineNumberBg":    { "dark": "#081808",      "light": "#081808" },
    "diffRemovedLineNumberBg":  { "dark": "#180808",      "light": "#180808" },
    "markdownText":             { "dark": "text",         "light": "text" },
    "markdownHeading":          { "dark": "text",         "light": "text" },
    "markdownLink":             { "dark": "foldText",     "light": "foldText" },
    "markdownLinkText":         { "dark": "foldText",     "light": "foldText" },
    "markdownCode":             { "dark": "foldText",     "light": "foldText" },
    "markdownBlockQuote":       { "dark": "textMuted",    "light": "textMuted" },
    "markdownEmph":             { "dark": "foldText",     "light": "foldText" },
    "markdownStrong":           { "dark": "text",         "light": "text" },
    "markdownHorizontalRule":   { "dark": "textMuted",    "light": "textMuted" },
    "markdownListItem":         { "dark": "foldText",     "light": "foldText" },
    "markdownListEnumeration":  { "dark": "foldText",     "light": "foldText" },
    "markdownImage":            { "dark": "foldText",     "light": "foldText" },
    "markdownImageText":        { "dark": "foldText",     "light": "foldText" },
    "markdownCodeBlock":        { "dark": "text",         "light": "text" },
    "syntaxComment":            { "dark": "textMuted",    "light": "textMuted" },
    "syntaxKeyword":            { "dark": "foldText",     "light": "foldText" },
    "syntaxFunction":           { "dark": "text",         "light": "text" },
    "syntaxVariable":           { "dark": "text",         "light": "text" },
    "syntaxString":             { "dark": "foldText",     "light": "foldText" },
    "syntaxNumber":             { "dark": "foldText",     "light": "foldText" },
    "syntaxType":               { "dark": "text",         "light": "text" },
    "syntaxOperator":           { "dark": "textMuted",    "light": "textMuted" },
    "syntaxPunctuation":        { "dark": "text",         "light": "text" }
  }
}
