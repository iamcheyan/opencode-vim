{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg":           "#151615",
    "bgPanel":      "#191a19",
    "bgElement":    "#222321",
    "bgMenu":       "#1e201e",
    "bgFold":       "#292a27",
    "border":       "#343632",
    "borderActive": "#77705b",
    "borderSubtle": "#292b28",
    "text":         "#d5d1c7",
    "textMuted":    "#85827a",
    "gold":         "#b4a77d",
    "blue":         "#879fa8",
    "green":        "#879b86",
    "purple":       "#9a8fa2",
    "red":          "#ad7d78",
    "code":         "#a9a28f",
    "lineNr":       "#666861"
  },
  "theme": {
    "primary":                  { "dark": "gold",         "light": "gold" },
    "secondary":                { "dark": "blue",         "light": "blue" },
    "accent":                   { "dark": "purple",       "light": "purple" },
    "error":                    { "dark": "red",          "light": "red" },
    "warning":                  { "dark": "gold",         "light": "gold" },
    "success":                  { "dark": "green",        "light": "green" },
    "info":                     { "dark": "blue",         "light": "blue" },
    "text":                     { "dark": "text",         "light": "text" },
    "textMuted":                { "dark": "textMuted",    "light": "textMuted" },
    "background":               { "dark": "bg",           "light": "bg" },
    "selectedListItemText":     { "dark": "bg",           "light": "bg" },
    "backgroundPanel":          { "dark": "bgPanel",      "light": "bgPanel" },
    "backgroundElement":        { "dark": "bgElement",    "light": "bgElement" },
    "backgroundMenu":           { "dark": "bgMenu",       "light": "bgMenu" },
    "border":                   { "dark": "border",       "light": "border" },
    "borderActive":             { "dark": "borderActive", "light": "borderActive" },
    "borderSubtle":             { "dark": "borderSubtle", "light": "borderSubtle" },
    "diffAdded":                { "dark": "green",        "light": "green" },
    "diffRemoved":              { "dark": "red",          "light": "red" },
    "diffContext":              { "dark": "textMuted",    "light": "textMuted" },
    "diffHunkHeader":           { "dark": "bgFold",       "light": "bgFold" },
    "diffHighlightAdded":       { "dark": "green",        "light": "green" },
    "diffHighlightRemoved":     { "dark": "red",          "light": "red" },
    "diffAddedBg":              { "dark": "#202820",      "light": "#202820" },
    "diffRemovedBg":            { "dark": "#2a2020",      "light": "#2a2020" },
    "diffContextBg":            { "dark": "bgPanel",      "light": "bgPanel" },
    "diffLineNumber":           { "dark": "lineNr",       "light": "lineNr" },
    "diffAddedLineNumberBg":    { "dark": "#1d241d",      "light": "#1d241d" },
    "diffRemovedLineNumberBg":  { "dark": "#261d1d",      "light": "#261d1d" },
    "markdownText":             { "dark": "text",         "light": "text" },
    "markdownHeading":          { "dark": "gold",         "light": "gold" },
    "markdownLink":             { "dark": "blue",         "light": "blue" },
    "markdownLinkText":         { "dark": "blue",         "light": "blue" },
    "markdownCode":             { "dark": "code",         "light": "code" },
    "markdownBlockQuote":       { "dark": "textMuted",    "light": "textMuted" },
    "markdownEmph":             { "dark": "purple",       "light": "purple" },
    "markdownStrong":           { "dark": "text",         "light": "text" },
    "markdownHorizontalRule":   { "dark": "textMuted",    "light": "textMuted" },
    "markdownListItem":         { "dark": "gold",         "light": "gold" },
    "markdownListEnumeration":  { "dark": "gold",         "light": "gold" },
    "markdownImage":            { "dark": "purple",       "light": "purple" },
    "markdownImageText":        { "dark": "purple",       "light": "purple" },
    "markdownCodeBlock":        { "dark": "text",         "light": "text" },
    "syntaxComment":            { "dark": "textMuted",    "light": "textMuted" },
    "syntaxKeyword":            { "dark": "purple",       "light": "purple" },
    "syntaxFunction":           { "dark": "blue",         "light": "blue" },
    "syntaxVariable":           { "dark": "text",         "light": "text" },
    "syntaxString":             { "dark": "green",        "light": "green" },
    "syntaxNumber":             { "dark": "gold",         "light": "gold" },
    "syntaxType":               { "dark": "code",         "light": "code" },
    "syntaxOperator":           { "dark": "textMuted",    "light": "textMuted" },
    "syntaxPunctuation":        { "dark": "text",         "light": "text" }
  }
}
